# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal student data — NEVER commit any of this.
# HAR captures and saved portal pages contain a real student's name, ID
# number, grades and GPA. The only transcript HTML in this repo is the
# synthetic fixture at src/lib/__fixtures__/transcript.html.
*.har
transcript*.html
!src/lib/__fixtures__/transcript.html

# Saved session/cookie caches. Nothing in this project should ever write one —
# the extension deliberately never touches a cookie — but an ignore entry
# costs nothing and a leaked session cookie costs a lot.
*.cookies
*cookie*.json
.*session*.json
.franciscan_session.json

# Working scratch: dated tarball/zip snapshots taken before each refactor, and
# the raw catalog pages they were checked against. Kept locally, not history.
_to_delete/
.fixtures/

# The department .xlsx advising handouts are Franciscan's own documents, not
# mine to redistribute. `npm run parse:guides` reads whatever .xlsx you drop in
# here; its output, data/derived/program-guides.json, is committed.
data/program-guides/*.xlsx

# Agent boilerplate that `next dev` writes into the project root.
AGENTS.md
CLAUDE.md
