      "notes": [
        {
          "section": null,
          "text": "Program of Study",
          "codes": []
        },
        {
          "section": "Bachelor of Arts Degree Requirements for Sacred Music (Organ) Major:",
          "text": "Majors are given a diagnostic placement exam for both Theory & Analysis and Ear Training. If a student tests into MUS 100 and/or MUS 104, then those are required courses to enter Theory & Analysis I (MUS 109) and Ear Training I (MUS 107), respectively. However, MUS 100 and MUS 104 credits do not count toward the major.",
          "codes": [
            "MUS 100",
            "MUS 104",
            "MUS 107",
            "MUS 100",
            "MUS 104"
          ]
        },
        {
          "section": "Bachelor of Arts Degree Requirements for Sacred Music (Organ) Major:",
          "text": "Seven semester (21 credits) of primary instrument courses are required (MUS 170, MUS 171, MUS 270, MUS 271, MUS 370, MUS 371, MUS 470).",
          "codes": [
            "MUS 170",
            "MUS 171",
            "MUS 270",
            "MUS 271",
            "MUS 370",
            "MUS 371",
            "MUS 470"
          ]
        },
        {
          "section": "Bachelor of Arts Degree Requirements for Sacred Music (Organ) Major:",
          "text": "Four semesters (4 credits) of secondary instrument courses are required (MUS 176 or MUS 183).",
          "codes": [
            "MUS 176",
            "MUS 183"
          ]
        },
        {
          "section": "Additional Requirements:",
          "text": "Upon the establishment of an organ studio, weekly mandatory performance classes will be held All majors are required to present a half-hour recital in their junior year and a one-hour recital in their senior year.",
          "codes": []
        }
      ],
