"Html": "<!-- Trimmed to the parts that matter: the results table carries the fully\r\n     built search endpoint, and the term dropdown states which terms exist,\r\n     what they're called and which one is selected. Student id replaced with a\r\n     synthetic one. -->\r\n<div class=\"AjaxPortletForm\">\r\n<input type=\"hidden\" name=\"CurrentPortletState\" value=\"Default\" />\r\n<input type=\"hidden\" name=\"ScreenToProcessForm\" value=\"StudentRegistrationPortlet_CourseSearchView\" />\r\n<input type=\"hidden\" name=\"NextScreenToLoad\" value=\"StudentRegistrationPortlet_CourseSearchView\" />\r\n<input type=\"hidden\" name=\"PostUrl\" value=\"/ICS/Academics/Academics_Homepage.jnz?portlet=Student_Registration&screen=StudentRegistrationPortlet_CourseSearchView&screenType=next\" />\r\n\r\n<select name=\"stuRegTermSelect\"\r\n        id=\"stuRegTermSelect\"\r\n        data-ajaxformsubmit=\"/ICS/Academics/Academics_Homepage.jnz?portlet=Student_Registration\">\r\n    <option value=\"2026;10\" selected>&nbsp;Fall 2026</option>\r\n    <optgroup label=\"Past Registration Periods\">\r\n        <option value='2025;10' >&nbsp;Fall 2025</option><option value='2025;20' >&nbsp;Spring 2026</option>\r\n    </optgroup>\r\n</select>\r\n\r\n<!-- The search form. The results table below is EMPTY until this is\r\n     submitted \u2014 see the data-no-rows-text attribute. -->\r\n<form id=\"courseSearchField\">\r\n<select name=\"ddCodeSearchType\" id=\"ddCodeSearchType\"><option value=\"0\">&nbsp;Begins With</option><option value=\"3\">&nbsp;Contains</option></select>\r\n<input type=\"text\" id=\"txtCourse\" name=\"txtCourse\" value=\"\" maxlength=\"30\"/>\r\n<select name=\"ddTitleSearchType\" id=\"ddTitleSearchType\"><option value=\"0\">&nbsp;Begins With</option></select>\r\n<input type=\"text\" id=\"txtCourseTitle\" name=\"txtCourseTitle\" value=\"\" maxlength=\"70\"/>\r\n<select name=\"ddDivision\" id=\"ddDivision\"><option value=\"\">&nbsp;</option><option value=\"UG\">&nbsp;Undergraduate</option></select>\r\n<input type=\"text\" id=\"txtInstructor\" name=\"txtInstructor\" class=\"form-control\"/>\r\n<input type=\"text\" id=\"txtDepartment\" name=\"txtDepartment\" class=\"form-control\"/>\r\n<input type=\"text\" id=\"txtLocation\" name=\"txtLocation\" class=\"form-control\"/>\r\n<button class=\"btn btn-primary submit-search\" type=\"button\">Search Courses</button>\r\n</form>\r\n\r\n<div class='footable-container'>\r\n<table id='CourseSearchResultsTable' class=' table-bordered '\r\ndata-url='/ICS/webserviceproxy/exi/rest/studentregistration/pagedsectiondataforsearch?Id=312&IdNumber=1000001&YearCode=2026&TermCode=10'\r\ndata-paging-size='15'\r\ndata-original-page-size='15'\r\ndata-paging='true'\r\ndata-no-rows-text='To see courses, enter criteria in any fields, and click Search Courses. To narrow the results, enter more criteria.'></table>\r\n</div>\r\n</div>\r\n"
