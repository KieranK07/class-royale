          "section": null,
          "text": "Program of Study",
          "codes": []
        },
        {
          "section": "Bachelor of Arts Degree Requirements for the English Major Writing Concentration:",
          "text": "The choice of English literature electives is regulated by the department. The department requires at least 3 credits in American Literature, 3 credits in British Literature, 3 credits in Contemporary or Modern Literature, and at least 3 credits in either British Literature, American Literature, or World Literature. The Department requires one Writing Elective selected from among the following courses: Business and Professional Writing (ENG 320), Teaching Writing as a Process (ENG 328), Editing and Proofreading (ENG 390).",
          "codes": [
            "ENG 390"
          ]
        }
