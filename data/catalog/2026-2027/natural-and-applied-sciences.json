        {
          "section": "Associate of Science",
          "text": "Twelve credits chosen from selected BIO, CHM, CSC or PHY course sequences, including at least six credits earned within a single course sequence, and including at least one course with a laboratory component; MTH 160 (or higher); three credits chosen from any CSC course (CSC 140 or higher) or EGR course(s); six additional credits chosen from any BIO, CHM, CSC, MTH, PHY, or SCI courses; one theology core, one philosophy core, one history or social science or American founding principles core, one literature core (ENG 211), one Catholic traditions in fine arts core.",
          "codes": [
            "MTH 160",
            "ENG 211"
          ]
        },
        {
